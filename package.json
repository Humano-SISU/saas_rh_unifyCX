{
  "name": "hr-saas-frontend",
  "version": "1.5.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "lint": "next lint --max-warnings=10000",
    "lint:ci": "next lint --quiet --max-warnings=10000",
    "typecheck": "tsc --noEmit",
    "build": "next build",
    "analyze": "ANALYZE=true next build",
    "start": "next start",
    "start:trace": "node -r ./lib/tracing.js node_modules/.bin/next start",
    "dev:trace": "node -r ./lib/tracing.js node_modules/.bin/next dev",
    "test": "tsx --test 'tests/*.test.ts'",
    "test:schema": "tsx --test tests/integration/landings-schema-drift.test.ts",
    "test:security": "npx tsx --test tests/shape-employee.test.ts tests/field-level-security.test.ts tests/field-level-security-phase2.test.ts tests/settings-access.test.ts tests/company-users.test.ts tests/attendance-kiosk-and-identity.test.ts tests/accounting-access.test.ts",
    "audit": "./scripts/run-complete-audit.sh",
    "audit:system": "node scripts/audit-system.js",
    "audit:supabase": "node scripts/audit-supabase.js",
    "audit:quick": "node scripts/audit-system.js && echo 'System audit completed. Run npm run audit:supabase for database audit.'",
    "audit:fix": "node scripts/fix-audit-issues.js",
    "audit:analyze": "node scripts/analyze-audit-report.js",
    "logs:dev": "node scripts/logs-dev.js",
    "logs:prod": "node scripts/logs-prod.js",
    "test:cookies": "node scripts/test-supabase-cookies.js",
    "prepare": "husky || true",
    "svgo": "svgo -f public -r",
    "staging:setup": "./scripts/setup-railway-staging.sh",
    "staging:check": "./scripts/check-staging-env.sh",
    "staging:deploy": "railway environment use staging && railway up",
    "railway:pro-infra": "./scripts/setup-railway-pro-infra.sh"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.9.1",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/auto-instrumentations-node": "^0.78.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.220.0",
    "@opentelemetry/sdk-node": "^0.220.0",
    "@radix-ui/react-select": "^2.2.5",
    "@sendgrid/mail": "^8.1.5",
    "@supabase/server": "^1.4.0",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.52.1",
    "@tailwindcss/forms": "^0.5.10",
    "@tailwindcss/typography": "^0.5.16",
    "@types/bcrypt": "^6.0.0",
    "@types/formidable": "^3.4.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/luxon": "^3.6.2",
    "@types/multiparty": "^4.2.1",
    "@types/node": "^24.1.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.3",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.5",
    "@types/winston": "^2.4.4",
    "autoprefixer": "^10.4.21",
    "axios": "^1.7.9",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.65.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "decimal.js": "^10.6.0",
    "dotenv": "^17.2.2",
    "exceljs": "^3.4.0",
    "formidable": "^3.5.4",
    "framer-motion": "^12.23.25",
    "gray-matter": "^4.0.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.526.0",
    "luxon": "^3.6.1",
    "marked": "^17.0.1",
    "multiparty": "^4.2.3",
    "next": "^15.5.29",
    "node-cron": "^4.6.0",
    "node-fetch": "^2.7.0",
    "pdfkit": "^0.17.2",
    "postcss": "^8.5.6",
    "raw-body": "^3.0.2",
    "react": "^19.1.0",
    "react-big-calendar": "^1.19.4",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.88.0",
    "recharts": "^3.2.1",
    "resend": "^6.1.0",
    "tailwind-merge": "^3.3.1",
    "typescript": "5.8.3",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^4.7.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@eslint/js": "^9.31.0",
    "@next/bundle-analyzer": "^15.5.20",
    "@types/marked": "^5.0.2",
    "@types/react-big-calendar": "^1.16.3",
    "@typescript-eslint/eslint-plugin": "^8.38.0",
    "@typescript-eslint/parser": "^8.38.0",
    "emoji-regex": "^10.4.0",
    "eslint": "^9.32.0",
    "eslint-config-next": "^15.4.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "svgo": "^3.3.2",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "yaml": "^2.9.0"
  }
}
